<!-- WinSW definition of the dashboard service. Installed as OpulentusWebService.xml
     next to OpulentusWebService.exe: WinSW reads the file that shares its executable's
     base name, so the copy in build-tree.ps1 renames it on purpose. -->
<service>
  <id>OpulentusWeb</id>
  <name>Opulentus dashboard</name>
  <description>Opulentus dashboard on http://localhost:38471 (loopback only).</description>
  <executable>%BASE%\web-start.cmd</executable>
  <workingdirectory>%BASE%\web-app</workingdirectory>
  <!-- The dashboard only talks to the API, so it starts after it and stops before it. -->
  <depend>Opulentus</depend>
  <log mode="roll" />
  <onfailure action="restart" delay="10 sec" />
</service>
