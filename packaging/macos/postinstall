#!/bin/sh
set -eu
mkdir -p '/Library/Application Support/Opulentus'
if [ ! -f /Library/Opulentus/.env ]; then cp /Library/Opulentus/.env.template /Library/Opulentus/.env; fi
chmod 600 /Library/Opulentus/.env
launchctl bootstrap system /Library/LaunchDaemons/com.opulentus.api.plist
launchctl bootstrap system /Library/LaunchDaemons/com.opulentus.web.plist
USER="$(stat -f%Su /dev/console)"
if [ "$USER" != "root" ]; then sudo -u "$USER" open http://localhost:38471 || true; fi
