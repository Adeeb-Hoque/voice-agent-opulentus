# The Opulentus API and agent loop. Configuration lives in
# /etc/opulentus/opulentus.env; data in /var/lib/opulentus.

[Unit]
Description=Opulentus API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=opulentus
Group=opulentus
EnvironmentFile=/etc/opulentus/opulentus.env
WorkingDirectory=/opt/opulentus
ExecStart=/bin/sh /opt/opulentus/api-start.sh
Restart=on-failure
RestartSec=3

# This process parses strangers' input for a living (§B14 in the spec) - keep it
# in as small a box as systemd offers without breaking normal operation.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opulentus
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
