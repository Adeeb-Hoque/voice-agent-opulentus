# The Opulentus dashboard - Next.js standalone served by the bundled Node.
# The published build serves the standard case: dashboard on localhost:38471,
# API on localhost:38472. Another hostname means rebuilding the dashboard with
# its own NEXT_PUBLIC_API_URL - see the repository's Docker documentation.

[Unit]
Description=Opulentus dashboard
After=opulentus-api.service
Wants=opulentus-api.service

[Service]
Type=exec
User=opulentus
Group=opulentus
WorkingDirectory=/opt/opulentus/web-app
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=38471
ExecStart=/opt/opulentus/node/bin/node web/server.js
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
